class Solution {
    public boolean isBipartite(int[][] graph) {
        boolean[] visited = new boolean[100]; // 100 bc constrains 
        boolean[] color = new boolean[100];
        Queue<Integer> q = new LinkedList<>();
        for (int row = 0; row < graph.length; row++) {
            if (graph[row].length == 0 || visited[row] == true) {
                // if dne or we already seen skip
                continue;
            }
            q.add(row);
            visited[row] = true;
            color[row] = true;

            while (!q.isEmpty()) {
                int node = q.poll();
                for (int neighbor : graph[node]) {
                    if (!visited[neighbor]) {
                        q.add(neighbor);
                        visited[neighbor] = true;
                        color[neighbor] = !color[node];
                    } else if (color[neighbor] == color[node]) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
}