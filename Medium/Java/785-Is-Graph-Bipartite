class Solution {

    public boolean isBipartite(int[][] graph) {
        boolean[] visited = new boolean[100];
        boolean[] color = new boolean[100];
        Queue<Integer> q = new LinkedList<>();

        for(int row = 0; row < graph.length - 1; row++) {
            if (visited[row] || graph[row].length == 0) {
                continue;
            }
            q.add(row);
            visited[row] = true;
            color[row] = true;

            while (!q.isEmpty()) {
                int node = q.poll();
                for(int neighbor: graph[node]) {
                    if (!visited[neighbor]) {
                        q.add(neighbor);
                        visited[neighbor] = true;
                        color[neighbor] = !color[node];
                    }
                    if (visited[neighbor] && color[neighbor] == color[node]) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
}